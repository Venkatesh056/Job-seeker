# Copy to .env and edit. Everything here is optional — the agent runs with none
# of it set, on SQLite, with on-device embeddings and no API keys.

# Leave unset for SQLite (default). Point at the Compose Postgres for pgvector:
# CAREERAGENT_DATABASE_URL=postgresql+psycopg://careeragent:careeragent@localhost:5433/careeragent

# CAREERAGENT_REDIS_URL=redis://localhost:6379/0
# CAREERAGENT_LOG_LEVEL=INFO

# Autonomy. 4 = prepare applications and queue them for approval (default).
# 5 = allow auto-submit above the threshold, on allow-listed ATS platforms only.
# CAREERAGENT_AUTONOMY_LEVEL=4
# CAREERAGENT_AUTO_SUBMIT_THRESHOLD=0.92
# CAREERAGENT_DAILY_APPLICATION_CAP=15

# LinkedIn/Indeed/Naukri/Glassdoor prohibit automated access in their terms.
# Enabling these is your call and your risk. See docs/02-roadmap.md section 4.1.
# CAREERAGENT_ENABLE_PORTAL_ADAPTERS=false

# ─── Company discovery (free tiers) ─────────────────────────────────────────
# These decide how many companies a region search finds. With none of them the agent
# reads three keyless boards that cover remote roles well and cities poorly — expect
# tens of companies rather than hundreds. Each is free and needs no card.
#
# Adzuna — instant key, ~hundreds of calls/day, proper India coverage.
#          https://developer.adzuna.com/signup
# CAREERAGENT_ADZUNA_APP_ID=
# CAREERAGENT_ADZUNA_APP_KEY=
#
# JSearch — Google Jobs index via RapidAPI, free tier 200 calls/MONTH. Reaches
#           LinkedIn/Indeed/Naukri postings through Google rather than by scraping.
#           https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# CAREERAGENT_RAPIDAPI_KEY=
#
# Jooble — free key on request, no published monthly cap.
#          https://jooble.org/api/about
# CAREERAGENT_JOOBLE_KEY=

# LLM keys are read from the OS keyring first; these env vars override.
# Not needed for discovery, scoring, resume parsing or form filling.
#
# This file is the COMMITTED TEMPLATE (see .gitignore: !.env.example).
# Put real keys in .env, which is gitignored. Never here.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
